---
import { navigation, sourceLinks } from '../lib/site';
import { withBase } from '../lib/paths';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-lead">
      <a class="footer-brand" href={withBase()}>SolProject</a>
      <p>An independent space sandbox, built from first principles.</p>
    </div>

    <nav aria-label="Footer navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={withBase(item.path)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-meta">
      <span>© 2026 SolProject</span>
      <a href={sourceLinks.repository}>Source code</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg-deep) 90%, transparent);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    width: min(calc(100% - 2 * var(--space-page)), var(--width-wide));
    margin-inline: auto;
    padding-block: var(--space-9) var(--space-6);
    gap: var(--space-8);
  }

  .footer-lead p {
    max-width: 28rem;
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
  }

  .footer-brand {
    color: var(--color-text);
    font-size: var(--step-2);
    font-weight: 760;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .footer-meta a {
    color: var(--color-muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  nav a:hover,
  .footer-meta a:hover {
    color: var(--color-accent-bright);
  }

  .footer-meta {
    display: flex;
    grid-column: 1 / -1;
    justify-content: space-between;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
    color: var(--color-dim);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 42rem) {
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .footer-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
    }
  }
</style>
