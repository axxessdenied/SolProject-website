---
import { navigation } from '../lib/site';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;
const homePath = withBase();

function isCurrent(path: string): boolean {
  const href = withBase(path);
  return path === '' ? currentPath === homePath : currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={homePath} aria-label="SolProject home">
      <span class="brand-mark" aria-hidden="true"><span></span></span>
      <span>SolProject</span>
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={withBase(item.path)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
    width: min(calc(100% - 2 * var(--space-page)), var(--width-wide));
    margin-inline: auto;
    gap: var(--space-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-text);
    font-size: var(--step-0);
    font-weight: 720;
    letter-spacing: -0.025em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-mark {
    position: relative;
    display: grid;
    width: 1.65rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 1rem
      color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .brand-mark::before,
  .brand-mark::after {
    position: absolute;
    width: 2.15rem;
    height: 0.35rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
    border-width: 1px 0;
    border-radius: 50%;
    content: '';
    transform: rotate(-28deg);
  }

  .brand-mark::after {
    transform: rotate(28deg);
  }

  .brand-mark span {
    width: 0.35rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent-bright);
    box-shadow: 0 0 0.7rem var(--color-accent);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: var(--step--1);
    font-weight: 620;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-text);
    background: var(--color-surface-soft);
  }

  nav a[aria-current='page'] {
    color: var(--color-accent-bright);
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
  }

  @media (max-width: 46rem) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    nav {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    nav ul {
      width: max-content;
      min-width: 100%;
      justify-content: space-between;
    }

    nav a {
      min-height: 2.75rem;
      padding-inline: 0.65rem;
    }
  }
</style>
