---
import { navigation } from '../lib/site';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;
const homePath = withBase();

function isCurrent(path: string): boolean {
  const href = withBase(path);
  return path === '' ? currentPath === homePath : currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={homePath} aria-label="The Stars Don’t Wait home">
      <img
        src={withBase('brand/the-stars-dont-wait-lockup-horizontal.svg')}
        alt=""
        width="1120"
        height="320"
      />
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={withBase(item.path)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
    width: min(calc(100% - 2 * var(--space-page)), var(--width-wide));
    margin-inline: auto;
    gap: var(--space-6);
  }

  .brand {
    display: block;
    width: clamp(9.5rem, 18vw, 13rem);
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: var(--step--1);
    font-weight: 620;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-text);
    background: var(--color-surface-soft);
  }

  nav a[aria-current='page'] {
    color: var(--color-accent-bright);
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
  }

  @media (max-width: 46rem) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    nav {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    nav ul {
      width: max-content;
      min-width: 100%;
      justify-content: space-between;
    }

    nav a {
      min-height: 2.75rem;
      padding-inline: 0.65rem;
    }
  }
</style>
