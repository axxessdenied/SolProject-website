---
import type { UpdateEntry } from '../lib/updates';
import { formatDate } from '../lib/updates';
import { withBase } from '../lib/paths';

interface Props {
  update: UpdateEntry;
}

const { update } = Astro.props;
---

<article class="update-card panel">
  <div class="update-meta">
    <time datetime={update.data.publishedAt}
      >{formatDate(update.data.publishedAt)}</time
    >
    <span aria-hidden="true">/</span>
    <span>{update.data.tags[0]}</span>
  </div>
  <h2>
    <a href={withBase(`updates/${update.data.slug}/`)}>{update.data.title}</a>
  </h2>
  <p>{update.data.description}</p>
  <a
    class="text-link"
    href={withBase(`updates/${update.data.slug}/`)}
    aria-label={`Read update: ${update.data.title}`}
  >
    Read update <span aria-hidden="true">↗</span>
  </a>
</article>
