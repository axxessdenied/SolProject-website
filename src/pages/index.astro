---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { sourceLinks } from '../lib/site';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="SolProject"
  description="Carve out a life as an independent starship captain in a living, procedurally generated galaxy."
>
  <section class="home-hero wide-container">
    <div class="hero-copy">
      <p class="eyebrow">Single-player · 3D space sandbox</p>
      <h1>A galaxy that moves without you.</h1>
      <p class="lede">
        Start with one underwhelming ship. Trade, fight, explore, and build a
        reputation inside a simulated frontier that never mistakes you for its
        chosen hero.
      </p>
      <div class="button-row">
        <a class="button" href={withBase('game/')}
          >Enter the galaxy <span aria-hidden="true">↗</span></a
        >
        <a class="button-secondary" href={withBase('engine/')}
          >Explore the engine</a
        >
      </div>
      <div class="hero-status">
        <span class="status-chip">Engine phases 0–7 complete</span>
        <span>Phase 8+ awaits detailed specifications</span>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="visual-frame">
        <span class="frame-label">SIM / SOL-01</span>
        <span class="frame-coordinates">RA 17H 45M · DEC −29°</span>
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="orbit orbit-three"></div>
        <div class="system-star"></div>
        <div class="system-planet"></div>
        <div class="system-ship"></div>
        <div class="scan-line"></div>
        <span class="frame-scale">100,000 KM</span>
      </div>
    </div>
  </section>

  <section class="wide-container section-pad">
    <SectionHeading
      eyebrow="Choose a heading"
      title="One ship. No prescribed path."
      intro="SolProject is being shaped around the freedom to follow a market signal, a distant contact, or a fight you probably should have avoided."
    />
    <div class="card-grid route-grid">
      <article class="info-card panel">
        <span class="index">01 / GAME</span>
        <h3>Live inside the simulation</h3>
        <p>
          Fly directly, take work, move goods, and earn your place. The map is a
          tool; the cockpit remains home.
        </p>
        <a class="text-link" href={withBase('game/')}
          >The player fantasy <span aria-hidden="true">↗</span></a
        >
      </article>
      <article class="info-card panel">
        <span class="index">02 / ENGINE</span>
        <h3>Built from first principles</h3>
        <p>
          A purpose-built C++20 engine handles space-scale precision, Vulkan
          rendering, simulation, tools, and data-driven content.
        </p>
        <a class="text-link" href={withBase('engine/')}
          >Under the hull <span aria-hidden="true">↗</span></a
        >
      </article>
      <article class="info-card panel">
        <span class="index">03 / ROADMAP</span>
        <h3>Progress, without fog</h3>
        <p>
          See what is implemented, what has been demonstrated, and what still
          exists only as a future direction.
        </p>
        <a class="text-link" href={withBase('roadmap/')}
          >Read the roadmap <span aria-hidden="true">↗</span></a
        >
      </article>
    </div>
  </section>

  <section class="manifesto wide-container section-pad">
    <div>
      <p class="eyebrow">The premise</p>
      <h2>You are a participant, not the center.</h2>
    </div>
    <div class="manifesto-copy">
      <p>
        Stations consume real goods. Traders move them. Shortages change prices.
        The game design calls for faction decisions and conflicts to emerge from
        those same interconnected systems—not from a script that waits for the
        player to arrive.
      </p>
      <p>
        The current engine foundation already demonstrates procedural systems,
        gate travel, docking, market simulation, coarse traders, combat, and
        lossless save/load. The deeper sandbox built on that foundation remains
        future work.
      </p>
      <a class="text-link" href={sourceLinks.gameDesign}
        >Read the canonical game design document
        <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>

  <section class="source-callout wide-container section-pad">
    <div class="source-panel panel">
      <div>
        <p class="eyebrow">Open development</p>
        <h2>Follow the build, not a pitch deck.</h2>
      </div>
      <div>
        <p>
          The engine source, architecture decisions, game design, and milestone
          evidence are public.
        </p>
        <a class="button-secondary" href={sourceLinks.repository}
          >View source <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(24rem, 0.95fr);
    min-height: min(50rem, calc(100vh - 4.75rem));
    align-items: center;
    padding-block: var(--space-8);
    gap: var(--space-7);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-copy h1 {
    max-width: 11ch;
    font-size: var(--step-5);
  }

  .hero-copy .lede {
    max-width: 36rem;
  }

  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--space-8);
    gap: var(--space-3);
    color: var(--color-dim);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .hero-visual {
    display: grid;
    min-height: 36rem;
    place-items: center;
  }

  .visual-frame {
    position: relative;
    width: min(100%, 35rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background:
      radial-gradient(circle at 56% 49%, rgb(72 213 186 / 7%), transparent 18%),
      radial-gradient(
        circle,
        rgb(11 30 36 / 84%),
        rgb(3 9 13 / 28%) 66%,
        transparent 67%
      );
    box-shadow:
      inset 0 0 5rem rgb(86 230 204 / 7%),
      0 0 8rem rgb(12 77 74 / 14%);
  }

  .visual-frame::before,
  .visual-frame::after {
    position: absolute;
    inset: 50% 0 auto;
    border-top: 1px solid var(--color-line);
    content: '';
  }

  .visual-frame::after {
    inset: 0 auto 0 50%;
    border-top: 0;
    border-left: 1px solid var(--color-line);
  }

  .frame-label,
  .frame-coordinates,
  .frame-scale {
    position: absolute;
    z-index: 2;
    color: var(--color-dim);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .frame-label {
    top: 10%;
    left: 12%;
    color: var(--color-accent-bright);
  }

  .frame-coordinates {
    top: 13%;
    left: 12%;
  }

  .frame-scale {
    right: 13%;
    bottom: 12%;
  }

  .orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-22deg);
  }

  .orbit-one {
    width: 34%;
    height: 18%;
  }

  .orbit-two {
    width: 64%;
    height: 34%;
  }

  .orbit-three {
    width: 94%;
    height: 53%;
  }

  .system-star {
    position: absolute;
    top: 48%;
    left: 53%;
    width: 3.2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #effff8;
    box-shadow:
      0 0 1rem #b5ffe9,
      0 0 3rem rgb(99 233 199 / 76%),
      0 0 8rem rgb(71 198 174 / 50%);
    transform: translate(-50%, -50%);
  }

  .system-planet {
    position: absolute;
    top: 36%;
    left: 25%;
    width: 1.15rem;
    aspect-ratio: 1;
    border: 1px solid #d9b878;
    border-radius: 50%;
    background: #8f7447;
    box-shadow: 0 0 1.5rem rgb(219 182 112 / 28%);
  }

  .system-ship {
    position: absolute;
    top: 67%;
    left: 72%;
    width: 0;
    height: 0;
    border-top: 0.38rem solid transparent;
    border-bottom: 0.38rem solid transparent;
    border-left: 0.8rem solid var(--color-accent-bright);
    filter: drop-shadow(0 0 0.4rem var(--color-accent));
    transform: rotate(-18deg);
  }

  .scan-line {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 47%;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    transform-origin: left;
    animation: scan 14s linear infinite;
  }

  @keyframes scan {
    to {
      transform: rotate(360deg);
    }
  }

  .route-grid .text-link {
    margin-top: var(--space-6);
  }

  .manifesto {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    border-top: 1px solid var(--color-line);
    gap: var(--space-8);
  }

  .manifesto-copy > p:first-child {
    margin-top: 0;
    color: var(--color-text);
    font-size: var(--step-1);
  }

  .manifesto-copy > p:nth-child(2) {
    color: var(--color-muted);
  }

  .manifesto-copy .text-link {
    margin-top: var(--space-4);
  }

  .source-panel {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: end;
    padding: var(--space-8);
    gap: var(--space-8);
  }

  .source-panel p:not(.eyebrow) {
    margin-top: 0;
    color: var(--color-muted);
  }

  @media (max-width: 58rem) {
    .home-hero {
      grid-template-columns: 1fr;
      padding-top: var(--space-9);
    }

    .hero-visual {
      min-height: auto;
    }

    .visual-frame {
      width: min(100%, 30rem);
    }

    .manifesto,
    .source-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .hero-visual {
      margin-inline: calc(-1 * var(--space-page));
    }

    .visual-frame {
      width: 30rem;
      max-width: 120vw;
    }

    .source-panel {
      padding: var(--space-6);
    }
  }
</style>
