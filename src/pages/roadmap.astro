---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { sourceLinks } from '../lib/site';

const completedPhases = [
  {
    number: '00',
    title: 'Scaffolding',
    summary: 'Build presets, module layout, test harness, and Windows CI.',
  },
  {
    number: '01',
    title: 'Platform + first triangle',
    summary: 'Win32 platform layer and validation-clean Vulkan bootstrap.',
  },
  {
    number: '02',
    title: 'Renderer foundations',
    summary:
      'Math, cooker v0, textured meshes, camera, ImGui, and shader reload.',
  },
  {
    number: '03',
    title: 'Core systems',
    summary:
      'Sparse-set ECS, jobs, fixed-step loop, serialization, and PRNG streams.',
  },
  {
    number: '04',
    title: 'Space-flight vertical slice',
    summary:
      'Space-scale precision, 6-DoF flight, HDR scene, HUD, and particles.',
  },
  {
    number: '05',
    title: 'Lua + data-driven content',
    summary:
      'Sandboxed scripting, strict TOML data, hot reload, and mod layering.',
  },
  {
    number: '06',
    title: 'Combat + AI',
    summary: 'Weapons, damage, collision, NPC pilots, and combat feedback.',
  },
  {
    number: '07',
    title: 'Universe + economy',
    summary:
      'Seeded galaxy, gate travel, docking, markets, coarse traders, and save/load.',
  },
] as const;

const sandboxMilestones = [
  {
    number: '8a–g',
    title: 'Career, factions + economy',
    summary:
      'Ship ownership and fitting, faction relations, simulation-driven missions, custom UI, exploration, mining, salvage, production chains, and market intelligence.',
    completed: 'August 15–16, 2026',
  },
  {
    number: '8h–m',
    title: 'Playtest-driven flight + mission flow',
    summary:
      'Radar, map controls, mission markers, direct target selection, rebindable controls, resilient bounty credit, live mission boards, and a modelled cockpit HUD.',
    completed: 'August 17, 2026',
  },
  {
    number: '8n–p',
    title: 'Measured performance + development UI',
    summary:
      'CPU and GPU frame instrumentation, one measured economy optimization, and full, compact, and hidden development-overlay modes.',
    completed: 'August 17, 2026',
  },
  {
    number: '8q–t',
    title: 'Remote maps, docking, comms + audio',
    summary:
      'Previously visited system maps, requested docking clearance and ports, pilot conversations, and the first cooked-audio and runtime-mixing path.',
    completed: 'August 18, 2026',
  },
  {
    number: '8u–z',
    title: 'Moving borders, physical travel + a living universe',
    summary:
      'Contested territory, fly-through gate transitions, visible economic and raider ships, unified collision queries, and discovery rules for stations and gates.',
    completed: 'August 18–19, 2026',
  },
] as const;

const followupMilestones = [
  {
    number: '10–11',
    title: 'Navigation surfaces + target ETA',
    summary:
      'Maps follow system changes, gate arrival faces the playfield, long labels disclose truncation, and target ETA uses actual relative closing speed.',
    completed: 'August 19, 2026',
    status: 'Complete',
  },
  {
    number: '12–13',
    title: 'Gate translucency + coherent worlds',
    summary:
      'A translucent gate membrane, resource-aware station placement, faction-shaped markets, and more visible system presence.',
    completed: 'August 20, 2026',
    status: 'Complete',
  },
  {
    number: '14–16',
    title: 'Authoring precision + target selection',
    summary:
      'Readable edit-grid values, reverse target cycling, clickable system maps, and asset tests that preserve invariants without freezing content.',
    completed: 'August 20, 2026',
    status: 'Complete',
  },
  {
    number: '17–18',
    title: 'Measured LOD thresholds + hysteresis',
    summary:
      'Screen-space measurements set mesh-level switches, and a stateful hold prevents shimmer near their boundaries. The milestone records show shipped work although their headings remain unreconciled.',
    completed: 'August 21, 2026',
    status: 'Recorded shipped',
  },
  {
    number: '19',
    title: 'Data-driven world models',
    summary:
      'Hardcoded model names left game code; validated roles and per-content overrides now choose geometry, and wrecks inherit the destroyed ship’s definition.',
    completed: 'August 21, 2026',
    status: 'Complete',
  },
] as const;
---

<BaseLayout
  title="Roadmap"
  description="A current view of The Stars Don’t Wait’s completed game, engine, and Forge authoring milestones."
>
  <PageIntro
    eyebrow="Roadmap / Status checked August 26, 2026"
    title="Built in runnable milestones."
    intro="The detailed engine plan advances through explicit exit criteria and recorded evidence. Phases 0–7 and all 26 Phase 8 sandbox passes are complete; later game work and Forge authoring stages have continued through the latest source snapshot."
  >
    <div class="button-row">
      <a class="button-secondary" href={sourceLinks.enginePlan}
        >Read the full engine plan <span aria-hidden="true">↗</span></a
      >
    </div>
  </PageIntro>

  <section class="wide-container roadmap-summary" aria-label="Roadmap summary">
    <div class="summary-item complete">
      <span>Complete</span>
      <strong>Phases 0–8z + later game passes</strong>
      <p>Playable foundation, refinement, and data-driven world content</p>
    </div>
    <div class="summary-item next">
      <span>Latest</span>
      <strong>Forge stage R</strong>
      <p>Reliable, exactly-once delivery from the Blender inbox</p>
    </div>
  </section>

  <section class="container section-pad">
    <SectionHeading
      eyebrow="Established foundation"
      title="The engine and simulation foundation."
      intro="The summaries below are curated from the canonical engine plan. Its full milestone notes contain measured results, deviations, and remaining caveats."
    />
    <ol class="roadmap-list">
      {
        completedPhases.map((phase) => (
          <li>
            <div class="phase-marker" aria-hidden="true">
              <span>{phase.number}</span>
            </div>
            <div class="phase-content">
              <div class="phase-heading">
                <h3>{phase.title}</h3>
                <span class="status-chip">Complete</span>
              </div>
              <p>{phase.summary}</p>
              <small>Completed August 15, 2026</small>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section-pad sandbox-section">
    <SectionHeading
      eyebrow="Sandbox depth / Implemented"
      title="Twenty-six focused passes formed the playable loop."
      intro="Phase 8a through 8z were specified and closed in small slices. These grouped summaries keep the public roadmap readable; the full plan preserves every milestone’s evidence and caveats."
    />
    <ol class="roadmap-list">
      {
        sandboxMilestones.map((phase) => (
          <li>
            <div class="phase-marker" aria-hidden="true">
              <span>{phase.number}</span>
            </div>
            <div class="phase-content">
              <div class="phase-heading">
                <h3>{phase.title}</h3>
                <span class="status-chip">Complete</span>
              </div>
              <p>{phase.summary}</p>
              <small>Completed {phase.completed}</small>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section-pad sandbox-section">
    <SectionHeading
      eyebrow="Follow-up phases / Implemented"
      title="Playtests and authoring work kept changing the build."
      intro="Numbered work after Phase 8 corrected navigation, added the first translucent rendering path, improved generated-world coherence, and removed hardcoded content boundaries."
    />
    <ol class="roadmap-list">
      {
        followupMilestones.map((phase) => (
          <li>
            <div class="phase-marker" aria-hidden="true">
              <span>{phase.number}</span>
            </div>
            <div class="phase-content">
              <div class="phase-heading">
                <h3>{phase.title}</h3>
                <span class="status-chip">{phase.status}</span>
              </div>
              <p>{phase.summary}</p>
              <small>{phase.completed}</small>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wide-container section-pad next-section">
    <div class="next-card panel">
      <div class="next-index" aria-hidden="true">R</div>
      <div>
        <p class="eyebrow">Latest completed / August 26</p>
        <h2>A Forge workflow that delivers every drop once</h2>
        <p class="next-intro">
          Phase 9 grew into a staged authoring programme. Its A–R records cover
          data-driven models, editable geometry, LODs, procedural textures,
          validated content rows, a dockable editor, and a Blender bridge. Stage
          R fixes the bridge’s pending-file lifecycle.
        </p>
        <ul class="future-list">
          <li>Import drops sent while the Forge was closed</li>
          <li>Archive successful deliveries outside the pending queue</li>
          <li>Skip the recursive archive on every later scan</li>
          <li>Keep failed drops visible without retrying every poll</li>
        </ul>
        <p class="horizon-note">
          No milestone after stage R is selected in the reviewed snapshot.
          Production packaging, broader content and playtesting, release polish,
          and the later Linux backend remain future work rather than a promised
          next phase.
        </p>
      </div>
    </div>
  </section>

  <section class="container section-pad roadmap-note">
    <div class="callout">
      <p>
        <strong>Roadmap language ages quickly.</strong> This page was checked against
        the detailed engine plan and source history on August 26, 2026. The repository
        README’s short status line still reports Phase 2, and the Phase 17–18 headings
        lag their own shipped records. Consult the full plan for the evidence and
        known gaps behind this curated view.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .roadmap-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--color-line);
  }

  .summary-item {
    display: grid;
    grid-template-columns: auto 1fr;
    padding: var(--space-6);
    gap: var(--space-2) var(--space-5);
  }

  .summary-item + .summary-item {
    border-left: 1px solid var(--color-line);
  }

  .summary-item > span {
    grid-row: 1 / 3;
    align-self: center;
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .summary-item.next > span {
    color: var(--color-warm);
  }

  .summary-item strong {
    font-size: var(--step-1);
  }

  .summary-item p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .roadmap-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sandbox-section {
    border-top: 1px solid var(--color-line);
  }

  .roadmap-list li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-6);
  }

  .phase-marker {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .phase-marker::after {
    position: absolute;
    z-index: -1;
    top: 2.6rem;
    bottom: -1rem;
    left: 50%;
    width: 1px;
    background: var(--color-line-strong);
    content: '';
  }

  .roadmap-list li:last-child .phase-marker::after {
    display: none;
  }

  .phase-marker span {
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    box-shadow: 0 0 1.5rem rgb(65 198 171 / 12%);
  }

  .phase-content {
    padding: 0 0 var(--space-7);
    border-bottom: 1px solid var(--color-line);
  }

  .phase-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .phase-content p {
    margin: var(--space-3) 0;
    color: var(--color-muted);
  }

  .phase-content small {
    color: var(--color-dim);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .next-section {
    border-top: 1px solid var(--color-line);
  }

  .next-card {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    padding: var(--space-8);
    border-color: color-mix(in srgb, var(--color-warm) 34%, transparent);
    gap: var(--space-8);
  }

  .next-index {
    align-self: start;
    color: color-mix(in srgb, var(--color-warm) 25%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(5rem, 13vw, 10rem);
    font-weight: 720;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .next-card .eyebrow {
    color: var(--color-warm);
  }

  .next-intro {
    max-width: 42rem;
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .future-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    gap: var(--space-3) var(--space-6);
  }

  .future-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--color-muted);
  }

  .future-list li::before {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--color-warm);
    content: '—';
  }

  .horizon-note {
    max-width: 44rem;
    margin: var(--space-6) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
    color: var(--color-dim);
    font-size: var(--step--1);
  }

  .roadmap-note {
    padding-top: 0;
  }

  @media (max-width: 48rem) {
    .roadmap-summary,
    .next-card,
    .future-list {
      grid-template-columns: 1fr;
    }

    .summary-item + .summary-item {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .next-card {
      padding: var(--space-6);
    }

    .next-index {
      font-size: 5rem;
    }
  }

  @media (max-width: 34rem) {
    .roadmap-list li {
      grid-template-columns: 3rem 1fr;
      gap: var(--space-3);
    }

    .phase-marker span {
      width: 2.6rem;
      height: 2.6rem;
    }

    .phase-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
