---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { sourceLinks } from '../lib/site';

const completedPhases = [
  {
    number: '00',
    title: 'Scaffolding',
    summary: 'Build presets, module layout, test harness, and Windows CI.',
  },
  {
    number: '01',
    title: 'Platform + first triangle',
    summary: 'Win32 platform layer and validation-clean Vulkan bootstrap.',
  },
  {
    number: '02',
    title: 'Renderer foundations',
    summary:
      'Math, cooker v0, textured meshes, camera, ImGui, and shader reload.',
  },
  {
    number: '03',
    title: 'Core systems',
    summary:
      'Sparse-set ECS, jobs, fixed-step loop, serialization, and PRNG streams.',
  },
  {
    number: '04',
    title: 'Space-flight vertical slice',
    summary:
      'Space-scale precision, 6-DoF flight, HDR scene, HUD, and particles.',
  },
  {
    number: '05',
    title: 'Lua + data-driven content',
    summary:
      'Sandboxed scripting, strict TOML data, hot reload, and mod layering.',
  },
  {
    number: '06',
    title: 'Combat + AI',
    summary: 'Weapons, damage, collision, NPC pilots, and combat feedback.',
  },
  {
    number: '07',
    title: 'Universe + economy',
    summary:
      'Seeded galaxy, gate travel, docking, markets, coarse traders, and save/load.',
  },
] as const;
---

<BaseLayout
  title="Roadmap"
  description="A clear view of SolProject’s completed engine milestones and the sandbox systems planned next."
>
  <PageIntro
    eyebrow="Roadmap / Status checked August 15, 2026"
    title="Built in runnable milestones."
    intro="The engine plan advances through explicit exit criteria and recorded evidence. Phases 0–7 are complete; Phase 8+ is intentionally still a sketch that must be specified before implementation."
  >
    <div class="button-row">
      <a class="button-secondary" href={sourceLinks.enginePlan}
        >Read the full engine plan <span aria-hidden="true">↗</span></a
      >
    </div>
  </PageIntro>

  <section class="wide-container roadmap-summary" aria-label="Roadmap summary">
    <div class="summary-item complete">
      <span>Complete</span>
      <strong>Phases 0–7</strong>
      <p>Engine through universe and economy foundation</p>
    </div>
    <div class="summary-item next">
      <span>Next</span>
      <strong>Phase 8+</strong>
      <p>Specify the next sandbox-depth milestone before starting it</p>
    </div>
  </section>

  <section class="container section-pad">
    <SectionHeading
      eyebrow="Established foundation"
      title="Eight phases, each ending in a proof."
      intro="The summaries below are curated from the canonical engine plan. Its full milestone notes contain measured results, deviations, and remaining caveats."
    />
    <ol class="roadmap-list">
      {
        completedPhases.map((phase) => (
          <li>
            <div class="phase-marker" aria-hidden="true">
              <span>{phase.number}</span>
            </div>
            <div class="phase-content">
              <div class="phase-heading">
                <h3>{phase.title}</h3>
                <span class="status-chip">Complete</span>
              </div>
              <p>{phase.summary}</p>
              <small>Completed August 15, 2026</small>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wide-container section-pad next-section">
    <div class="next-card panel">
      <div class="next-index" aria-hidden="true">08+</div>
      <div>
        <p class="eyebrow">Future direction / Not started</p>
        <h2>Sandbox depth</h2>
        <p class="next-intro">
          The plan identifies the systems that can turn the technical foundation
          into the broader game, but explicitly requires each item to receive
          its own specification before implementation.
        </p>
        <ul class="future-list">
          <li>Faction simulation and player reputation</li>
          <li>Lua-authored missions and contracts</li>
          <li>Ship purchasing, outfitting, and progression</li>
          <li>Custom player-facing UI and audio</li>
          <li>Mining, salvage, exploration, and scanning</li>
          <li>Performance hardening and a later Linux backend</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container section-pad roadmap-note">
    <div class="callout">
      <p>
        <strong>Roadmap language ages quickly.</strong> This page was checked against
        the canonical engine plan on August 15, 2026. Consult the full plan for the
        newest phase status and milestone evidence.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .roadmap-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--color-line);
  }

  .summary-item {
    display: grid;
    grid-template-columns: auto 1fr;
    padding: var(--space-6);
    gap: var(--space-2) var(--space-5);
  }

  .summary-item + .summary-item {
    border-left: 1px solid var(--color-line);
  }

  .summary-item > span {
    grid-row: 1 / 3;
    align-self: center;
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .summary-item.next > span {
    color: var(--color-warm);
  }

  .summary-item strong {
    font-size: var(--step-1);
  }

  .summary-item p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .roadmap-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-list li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-6);
  }

  .phase-marker {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .phase-marker::after {
    position: absolute;
    z-index: -1;
    top: 2.6rem;
    bottom: -1rem;
    left: 50%;
    width: 1px;
    background: var(--color-line-strong);
    content: '';
  }

  .roadmap-list li:last-child .phase-marker::after {
    display: none;
  }

  .phase-marker span {
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    box-shadow: 0 0 1.5rem rgb(65 198 171 / 12%);
  }

  .phase-content {
    padding: 0 0 var(--space-7);
    border-bottom: 1px solid var(--color-line);
  }

  .phase-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .phase-content p {
    margin: var(--space-3) 0;
    color: var(--color-muted);
  }

  .phase-content small {
    color: var(--color-dim);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .next-section {
    border-top: 1px solid var(--color-line);
  }

  .next-card {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    padding: var(--space-8);
    border-color: color-mix(in srgb, var(--color-warm) 34%, transparent);
    gap: var(--space-8);
  }

  .next-index {
    align-self: start;
    color: color-mix(in srgb, var(--color-warm) 25%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(5rem, 13vw, 10rem);
    font-weight: 720;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .next-card .eyebrow {
    color: var(--color-warm);
  }

  .next-intro {
    max-width: 42rem;
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .future-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    gap: var(--space-3) var(--space-6);
  }

  .future-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--color-muted);
  }

  .future-list li::before {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--color-warm);
    content: '—';
  }

  .roadmap-note {
    padding-top: 0;
  }

  @media (max-width: 48rem) {
    .roadmap-summary,
    .next-card,
    .future-list {
      grid-template-columns: 1fr;
    }

    .summary-item + .summary-item {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .next-card {
      padding: var(--space-6);
    }

    .next-index {
      font-size: 5rem;
    }
  }

  @media (max-width: 34rem) {
    .roadmap-list li {
      grid-template-columns: 3rem 1fr;
      gap: var(--space-3);
    }

    .phase-marker span {
      width: 2.6rem;
      height: 2.6rem;
    }

    .phase-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
