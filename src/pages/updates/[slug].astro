---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compareUpdates, formatDate } from '../../lib/updates';
import { withBase } from '../../lib/paths';

interface Props {
  update: CollectionEntry<'updates'>;
}

export async function getStaticPaths() {
  const updates = (
    await getCollection('updates', ({ data }) => !data.draft)
  ).sort(compareUpdates);

  return updates.map((update) => ({
    params: { slug: update.data.slug },
    props: { update },
  }));
}

const { update } = Astro.props;
const { Content } = await render(update);
---

<BaseLayout title={update.data.title} description={update.data.description}>
  <article class="update-article container section-pad">
    <a class="back-link" href={withBase('updates/')}
      ><span aria-hidden="true">←</span> All updates</a
    >

    <header class="article-header">
      <div class="update-meta">
        <span>Published</span>
        <time datetime={update.data.publishedAt}
          >{formatDate(update.data.publishedAt)}</time
        >
        {
          update.data.updatedAt && (
            <>
              <span>/ Updated</span>
              <time datetime={update.data.updatedAt}>
                {formatDate(update.data.updatedAt)}
              </time>
            </>
          )
        }
      </div>
      <h1>{update.data.title}</h1>
      <p class="lede">{update.data.description}</p>
      <ul class="tag-list" aria-label="Tags">
        {update.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    <div class="article-body prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .update-article {
    max-width: var(--width-reading);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--step--1);
    font-weight: 650;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent-bright);
  }

  .article-header {
    padding-block: var(--space-7) var(--space-8);
    border-bottom: 1px solid var(--color-line);
  }

  .article-header h1 {
    margin-top: var(--space-5);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    margin: var(--space-6) 0 0;
    padding: 0;
    gap: var(--space-2);
    list-style: none;
  }

  .tag-list li {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 99rem;
    color: var(--color-dim);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
  }

  .article-body {
    padding-top: var(--space-6);
  }
</style>
